{
  "name": "DS100",
  "hostRequirements": {
    "cpus": 2
  },
  "updateContentCommand": "python -m pip install --disable-pip-version-check --no-cache-dir -r requirements.txt",
  "waitFor": "updateContentCommand",
  "postAttachCommand": [
    "code",
    "--reuse-window",
    "${containerWorkspaceFolder}/hw05.ipynb"
  ],
  "customizations": {
    "codespaces": {
      "disableAutomaticConfiguration": true
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "github.copilot.enable": {
          "*": false
        },
        "github.copilot.nextEditSuggestions.enabled": false,
        "chat.disableAIFeatures": true
      }
    }
  }
}
